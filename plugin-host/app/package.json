{
  "name": "@valtimo/plugin-host",
  "version": "0.1.0",
  "description": "Valtimo External Plugin Host — Node.js + Fastify + Extism sidecar",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "installDeps": "npm i",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:wasm": "vitest run -c vitest.wasm.config.ts",
    "test:int": "vitest run -c vitest.int.config.ts",
    "start": "node dist/index.js",
    "dev": "node scripts/dev.mjs",
    "migrate": "node dist/migrate.js",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations --migration-file-language sql --migration-filename-format utc",
    "clean": "node -e \"const fs=require('fs');for(const d of ['dist','.tmp','plugins'])fs.rmSync(d,{recursive:true,force:true})\"",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d db",
    "db:logs": "docker compose logs -f db",
    "db:shell": "docker compose exec db psql -U pluginhost -d pluginhost",
    "docker:build": "docker compose build plugin-host",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f plugin-host"
  },
  "dependencies": {
    "@extism/extism": "^2.0.0-rc13",
    "@fastify/multipart": "^10.0.0",
    "@valtimo/plugin-sdk": "file:../plugin-sdk",
    "adm-zip": "^0.5.17",
    "amqplib": "^0.10.9",
    "fastify": "^5.8.5",
    "fastify-raw-body": "^5.0.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.21.0",
    "pino": "^9.6.0",
    "undici": "^7.28.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.28.0",
    "@testcontainers/rabbitmq": "^10.28.0",
    "@types/adm-zip": "^0.5.8",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^3.2.0",
    "testcontainers": "^10.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "EUPL-1.2"
}
