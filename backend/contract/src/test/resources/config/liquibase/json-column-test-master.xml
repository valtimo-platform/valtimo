<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <property name="uuidType" value="BINARY(16)" dbms="mysql"/>
    <property name="uuidType" value="uuid" dbms="postgresql"/>

    <property name="jsonType" value="JSON" dbms="mysql"/>
    <property name="jsonType" value="JSONB" dbms="postgresql"/>

    <changeSet author="Ritense" id="json-column-test-1">
        <createTable tableName="json_column_test">
            <column name="id" type="${uuidType}">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="object_node" type="${jsonType}"/>
            <column name="json_map" type="${jsonType}"/>
            <column name="pojo_list" type="${jsonType}"/>
            <column name="pojo" type="${jsonType}"/>
            <column name="raw_json" type="${jsonType}"/>
            <column name="flag" type="${jsonType}"/>
        </createTable>
    </changeSet>

    <changeSet author="Ritense" id="json-column-test-2">
        <createTable tableName="json_plain_column_test">
            <column name="id" type="${uuidType}">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="object_node" type="JSON"/>
            <column name="raw_json" type="JSON"/>
            <column name="long_text" type="TEXT"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
