<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

    <changeSet author="Ritense" id="1">
        <createTable tableName="marketplace_package_job">
            <column name="id" type="${uuidType}">
                <constraints nullable="false" primaryKey="true" primaryKeyName="marketplacePackageJobPK"/>
            </column>
            <column name="package_id" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="package_name" type="VARCHAR(512)"/>
            <column name="package_type" type="VARCHAR(64)"/>
            <column name="operation" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="from_version" type="VARCHAR(128)"/>
            <column name="to_version" type="VARCHAR(128)"/>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="stage" type="VARCHAR(32)"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="created_on" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="finished_on" type="DATETIME"/>
            <column name="error_message" type="TEXT"/>
        </createTable>
    </changeSet>

    <changeSet author="Ritense" id="2">
        <!-- The activity list is always read newest-first, and the per-package history is
             read from the package detail page. -->
        <createIndex tableName="marketplace_package_job" indexName="marketplace_package_job_created_on_index">
            <column name="created_on"/>
        </createIndex>
        <createIndex tableName="marketplace_package_job" indexName="marketplace_package_job_package_id_index">
            <column name="package_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
