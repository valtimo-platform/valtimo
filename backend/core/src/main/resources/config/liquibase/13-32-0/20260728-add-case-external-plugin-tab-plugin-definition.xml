<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd" logicalFilePath="config/liquibase/changelog/20260728-add-case-external-plugin-tab-plugin-definition.xml">

    <!--
      Design-time plugin identity for an EXTERNAL_PLUGIN case tab, mirroring the
      plugin_definition_key / plugin_definition_version columns on process_link. Persisted so a
      dangling tab (its configuration deleted from this environment) stays identifiable in the
      "missing plugin configurations" repair panel, which reads the database rather than the export.
      Nullable: legacy rows and configurations that could not be resolved at import carry no key.
    -->
    <changeSet id="1" author="Ritense">
        <addColumn tableName="case_external_plugin_tab">
            <column name="plugin_definition_key" type="varchar(128)"/>
            <column name="plugin_definition_version" type="varchar(64)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
