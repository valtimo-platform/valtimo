<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd"
                   logicalFilePath="config/liquibase/13-32-0/20260716-external-plugin-granted-capability.xml">

    <changeSet author="Ritense" id="1">
        <createTable tableName="external_plugin_granted_capability">
            <column name="id" type="${uuidType}">
                <constraints nullable="false" primaryKey="true" primaryKeyName="ext_plugin_granted_cap_pk"/>
            </column>
            <column name="configuration_id" type="${uuidType}">
                <constraints nullable="false"/>
            </column>
            <column name="capability" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="granted_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
            tableName="external_plugin_granted_capability"
            columnNames="configuration_id, capability"
            constraintName="ext_plugin_granted_cap_config_capability_uq"/>

        <addForeignKeyConstraint
            baseTableName="external_plugin_granted_capability"
            baseColumnNames="configuration_id"
            referencedTableName="external_plugin_configuration"
            referencedColumnNames="id"
            constraintName="ext_plugin_granted_cap_config_fk"
            onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
