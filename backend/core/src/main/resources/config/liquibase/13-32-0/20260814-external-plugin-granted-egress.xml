<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd"
                   logicalFilePath="config/liquibase/13-32-0/20260814-external-plugin-granted-egress.xml">

    <changeSet author="Ritense" id="1">
        <createTable tableName="external_plugin_granted_egress">
            <column name="id" type="${uuidType}">
                <constraints nullable="false" primaryKey="true" primaryKeyName="ext_plugin_granted_egress_pk"/>
            </column>
            <column name="configuration_id" type="${uuidType}">
                <constraints nullable="false"/>
            </column>
            <column name="target" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="granted_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
            tableName="external_plugin_granted_egress"
            columnNames="configuration_id, target"
            constraintName="ext_plugin_granted_egress_config_target_uq"/>

        <addForeignKeyConstraint
            baseTableName="external_plugin_granted_egress"
            baseColumnNames="configuration_id"
            referencedTableName="external_plugin_configuration"
            referencedColumnNames="id"
            constraintName="ext_plugin_granted_egress_config_fk"
            onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
