<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd"
                   logicalFilePath="config/liquibase/13-32-0/20260706-add-external-plugin-task-form-process-link.xml">

    <!--
      Columns for the external-plugin `task-form` process-link subtype (discriminator
      `external_plugin_task_form`). Single-table inheritance on `process_link`, so the columns are
      nullable — rows of other link types leave them null. Distinct from the service-task action
      columns (`external_plugin_*`) because the surfaces are unrelated.
    -->
    <changeSet author="Ritense" id="1">
        <preConditions onFail="CONTINUE">
            <tableExists tableName="process_link"/>
        </preConditions>
        <addColumn tableName="process_link">
            <column name="external_plugin_task_form_config_id" type="${uuidType}"/>
            <column name="external_plugin_task_form_bundle_key" type="VARCHAR(255)"/>
            <column name="external_plugin_task_form_version" type="VARCHAR(64)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
