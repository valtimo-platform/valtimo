<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd"
                   logicalFilePath="config/liquibase/13-32-0/20260812-external-plugin-frontend-origins.xml">

    <!--
      Browser origins allowed to embed this host's plugin screens, as a comma-separated list of
      `scheme://host[:port]` entries. GZAC pushes them to the plugin host, which serves them as the
      `frame-ancestors` CSP directive. NULL means none registered yet — existing hosts keep that
      until an admin edits them, and their bundles are not framable in the meantime (fail closed).
    -->
    <changeSet id="1" author="Ritense">
        <addColumn tableName="external_plugin_host">
            <column name="frontend_origins" type="VARCHAR(2000)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
