<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd"
                   logicalFilePath="config/liquibase/13-32-0/20260720-plugin-action-result-mappings.xml">

    <!--
      Shared column on process_link, mapped by both PluginProcessLink (embedded) and
      ExternalPluginProcessLink — same STI column-sharing approach already verified for
      plugin_definition_version (20260720-plugin-configuration-reference-external-plugin-version.xml).
      Shape: [{ "source": "/json/pointer", "target": "doc:/path" | "pv:name" | "case:..." }].
    -->
    <changeSet author="Ritense" id="1">
        <preConditions onFail="CONTINUE">
            <tableExists tableName="process_link"/>
        </preConditions>
        <addColumn tableName="process_link">
            <column name="action_result_mappings" type="${jsonType}"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
