<databaseChangeLog
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

    <!--
        Plan-level skeleton of a migration plan. Component sections (dataMigration owned by the
        case module, processMigration owned by the core module, ...) are stored in their own
        tables. Composite-key VARCHAR lengths are kept within MySQL's 3072-byte index limit
        (utf8mb4, 4 bytes per char).
    -->
    <changeSet id="1" author="Ritense">
        <createTable tableName="case_definition_migration">
            <column name="case_definition_key" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="case_definition_version_tag" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="migration_key" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(512)"/>
            <column name="migration_triggers" type="${jsonType}">
                <constraints nullable="false"/>
            </column>
            <column name="conditions" type="${jsonType}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="case_definition_migration"
                       columnNames="case_definition_key, case_definition_version_tag, migration_key"/>
    </changeSet>

    <!-- The 'dataMigration' component, owned by the case module. -->
    <changeSet id="2" author="Ritense">
        <createTable tableName="case_definition_migration_data">
            <column name="case_definition_key" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="case_definition_version_tag" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="migration_key" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="patches" type="${jsonType}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="case_definition_migration_data"
                       columnNames="case_definition_key, case_definition_version_tag, migration_key"/>
    </changeSet>

    <!-- The 'processMigration' component, owned by the core module. -->
    <changeSet id="3" author="Ritense">
        <createTable tableName="case_definition_migration_process">
            <column name="case_definition_key" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="case_definition_version_tag" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="migration_key" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="instructions" type="${jsonType}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="case_definition_migration_process"
                       columnNames="case_definition_key, case_definition_version_tag, migration_key"/>
    </changeSet>

    <!-- Run state of a migration plan: powers the UI status and runAfter ordering. -->
    <changeSet id="4" author="Ritense">
        <createTable tableName="case_definition_migration_execution">
            <column name="case_definition_key" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="case_definition_version_tag" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="migration_key" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="cases_to_migrate" type="${intType}" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="migrated_case_ids" type="${jsonType}">
                <constraints nullable="false"/>
            </column>
            <column name="errors" type="${jsonType}">
                <constraints nullable="false"/>
            </column>
            <column name="started_on" type="datetime"/>
            <column name="finished_on" type="datetime"/>
        </createTable>
        <addPrimaryKey tableName="case_definition_migration_execution"
                       columnNames="case_definition_key, case_definition_version_tag, migration_key"/>
    </changeSet>

    <!-- Optimistic-locking version for the execution record (concurrency guard). -->
    <changeSet id="5" author="Ritense">
        <addColumn tableName="case_definition_migration_execution">
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- Lease expiry: a live node renews it while running; an expired lease may be taken over. -->
    <changeSet id="6" author="Ritense">
        <addColumn tableName="case_definition_migration_execution">
            <column name="lease_expires_at" type="datetime"/>
        </addColumn>
    </changeSet>

    <!-- Fencing token: the running node stops if the token no longer matches (it was taken over). -->
    <changeSet id="7" author="Ritense">
        <addColumn tableName="case_definition_migration_execution">
            <column name="run_token" type="VARCHAR(64)"/>
        </addColumn>
    </changeSet>

    <!-- Per-case migration result: one row per (plan, case), so progress is O(1) per case instead
         of a growing collection on the execution row. -->
    <changeSet id="8" author="Ritense">
        <createTable tableName="case_definition_migration_case">
            <column name="case_definition_key" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="case_definition_version_tag" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="migration_key" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="case_id" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="error_message" type="VARCHAR(2048)"/>
        </createTable>
        <addPrimaryKey tableName="case_definition_migration_case"
                       columnNames="case_definition_key, case_definition_version_tag, migration_key, case_id"/>
    </changeSet>

    <!-- Progress moved to case_definition_migration_case; drop the old per-execution collections. -->
    <changeSet id="9" author="Ritense">
        <dropColumn tableName="case_definition_migration_execution" columnName="migrated_case_ids"/>
        <dropColumn tableName="case_definition_migration_execution" columnName="errors"/>
    </changeSet>

    <!-- Cached, approximate count of matching cases, refreshed by the trigger sweep so the UI can
         show "cases to migrate" before a run starts. -->
    <changeSet id="10" author="Ritense">
        <addColumn tableName="case_definition_migration">
            <column name="estimated_cases_to_migrate" type="${intType}"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
