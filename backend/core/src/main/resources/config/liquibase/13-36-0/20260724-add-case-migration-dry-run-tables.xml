<databaseChangeLog
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

    <!--
        A migration plan dry run simulates migrating every matching case (running the real
        migration inside a transaction that is always rolled back) and records, per case, whether
        it would migrate or fail. Kept in its own tables so dry-run state never influences whether a
        real run migrates or skips a case. Keyed by the same neutral composite id as the real-run
        tables (blueprint_type, blueprint_key, blueprint_version_tag, migration_key), and column
        types match those tables (VARCHAR lengths stay within MySQL's 3072-byte index limit).
    -->
    <changeSet id="1" author="Ritense">
        <createTable tableName="blueprint_migration_dry_run">
            <column name="blueprint_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="blueprint_key" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="blueprint_version_tag" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="migration_key" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="lease_expires_at" type="datetime"/>
            <column name="run_token" type="VARCHAR(64)"/>
            <column name="started_on" type="datetime"/>
            <column name="finished_on" type="datetime"/>
        </createTable>
        <addPrimaryKey tableName="blueprint_migration_dry_run"
                       columnNames="blueprint_type, blueprint_key, blueprint_version_tag, migration_key"/>
    </changeSet>

    <!-- Per-instance dry-run result: one row per (plan, instance) with the simulated outcome. -->
    <changeSet id="2" author="Ritense">
        <createTable tableName="blueprint_migration_dry_run_case">
            <column name="blueprint_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="blueprint_key" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="blueprint_version_tag" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="migration_key" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="case_id" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="error_message" type="clob"/>
        </createTable>
        <addPrimaryKey tableName="blueprint_migration_dry_run_case"
                       columnNames="blueprint_type, blueprint_key, blueprint_version_tag, migration_key, case_id"/>
    </changeSet>

</databaseChangeLog>
