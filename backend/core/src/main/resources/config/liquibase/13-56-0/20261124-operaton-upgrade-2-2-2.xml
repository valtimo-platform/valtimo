<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd"
    logicalFilePath="config/liquibase/13-56-0/20261124-operaton-upgrade-2-2-2.xml">

    <!-- Operaton 2.2.2 ships engine schema 7.25.0. The 7.24 to 7.25 upgrade script only logs the new version. -->
    <changeSet id="1" author="Ritense">
        <preConditions onFail="MARK_RAN">
            <not>
                <sqlCheck expectedResult="1">
                    select count(*)
                    from ACT_GE_SCHEMA_LOG
                    where version_ = '7.25.0'
                </sqlCheck>
            </not>
        </preConditions>
        <comment>mysql_engine_7.24_to_7.25.sql and postgres_engine_7.24_to_7.25.sql</comment>
        <insert tableName="ACT_GE_SCHEMA_LOG">
            <column name="ID_" value="1400"/>
            <column name="TIMESTAMP_" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="VERSION_" value="7.25.0"/>
        </insert>
    </changeSet>

</databaseChangeLog>
