<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd"
                   logicalFilePath="config/liquibase/changelog/20261102-add-group-hidden-list-column-and-search-field-unique.xml">
    <changeSet id="1" author="Ritense">
        <createTable tableName="group_hidden_list_column">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" primaryKeyName="pk_group_hidden_list_column"/>
            </column>
            <column name="user_id" type="VARCHAR(256)">
                <constraints nullable="false"/>
            </column>
            <column name="group_key" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="column_key" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="group_hidden_list_column"
                                 baseColumnNames="group_key"
                                 constraintName="fk_group_hidden_list_column_group_key"
                                 referencedTableName="case_definition_group"
                                 referencedColumnNames="key"
                                 onDelete="CASCADE"/>
        <createIndex tableName="group_hidden_list_column" indexName="idx_group_hidden_list_column_user_group">
            <column name="user_id"/>
            <column name="group_key"/>
        </createIndex>
    </changeSet>

    <changeSet id="2" author="Ritense">
        <addUniqueConstraint tableName="group_search_field"
                             columnNames="group_key, field_key"
                             constraintName="uq_group_search_field_group_key_field_key"/>
    </changeSet>
</databaseChangeLog>
