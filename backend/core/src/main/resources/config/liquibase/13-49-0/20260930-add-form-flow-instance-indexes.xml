<databaseChangeLog
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd"
    logicalFilePath="config/liquibase/changelog/20260930-add-form-flow-instance-indexes.xml">

    <!-- Postgres only: MySQL auto-indexes FK columns -->

    <changeSet id="1" author="Ritense" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="form_flow_step_instance" indexName="idx_form_flow_step_instance_instance_id"/>
            </not>
        </preConditions>
        <createIndex tableName="form_flow_step_instance" indexName="idx_form_flow_step_instance_instance_id">
            <column name="form_flow_instance_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="2" author="Ritense" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="form_flow_instance" indexName="idx_form_flow_instance_definition"/>
            </not>
        </preConditions>
        <createIndex tableName="form_flow_instance" indexName="idx_form_flow_instance_definition">
            <column name="form_flow_definition_key"/>
            <column name="blueprint_type"/>
            <column name="blueprint_key"/>
            <column name="blueprint_version_tag"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
