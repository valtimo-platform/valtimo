<databaseChangeLog
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd"
    logicalFilePath="config/liquibase/changelog/20261005-add-case-configuration-tables.xml">

    <!-- Configuration keys and default values declared by a case definition version -->
    <changeSet id="1" author="Ritense">
        <createTable tableName="case_configuration_declaration">
            <column name="case_definition_key" type="VARCHAR(256)">
                <constraints nullable="false"/>
            </column>
            <column name="case_definition_version_tag" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="configuration_key" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="default_value" type="VARCHAR(4000)"/>
        </createTable>
        <addPrimaryKey tableName="case_configuration_declaration"
                       columnNames="case_definition_key, case_definition_version_tag, configuration_key"
                       constraintName="pk_case_configuration_declaration"/>
    </changeSet>

    <!-- Environment values per case definition key, so they survive new versions -->
    <changeSet id="2" author="Ritense">
        <createTable tableName="case_configuration_environment_value">
            <column name="case_definition_key" type="VARCHAR(256)">
                <constraints nullable="false"/>
            </column>
            <column name="configuration_key" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="environment_value" type="VARCHAR(4000)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="case_configuration_environment_value"
                       columnNames="case_definition_key, configuration_key"
                       constraintName="pk_case_configuration_environment_value"/>
    </changeSet>

</databaseChangeLog>
