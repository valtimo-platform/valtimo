<databaseChangeLog
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <!--
      Tasks are matched to their case document on the business key, which is text. Comparing it to
      building_block_document_id therefore casts that column, and uc_bbinst_document cannot serve
      the lookup. Without this index the subquery scans the whole table per task row.

      The expressions must stay identical to QueryDialectHelper.uuidToString, or the index is not used.
    -->
    <changeSet author="Ritense" id="1" dbms="postgresql">
        <sql>
            CREATE INDEX idx_bbinst_document_text
            ON building_block_instance (CAST(building_block_document_id AS VARCHAR))
        </sql>
    </changeSet>

    <changeSet author="Ritense" id="1" dbms="mysql">
        <sql>
            CREATE INDEX idx_bbinst_document_text
            ON building_block_instance ((BIN_TO_UUID(building_block_document_id)))
        </sql>
    </changeSet>

</databaseChangeLog>
