<?xml version="1.0" encoding="UTF-8"?>
<!--
  Deliberately outside config/global/** so it is not auto-deployed, and deliberately waiting on a
  receive task rather than a user task: a user task that stays open would change the task counts
  other integration tests assert on. Tests deploy this at runtime to get a system process with a
  running instance to migrate.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_system_receive_task" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="system-receive-task-process" name="System Receive Task Process" isExecutable="true">
    <bpmn:extensionElements>
      <camunda:properties>
        <camunda:property name="systemProcess" value="true" />
      </camunda:properties>
    </bpmn:extensionElements>
    <bpmn:startEvent id="SystemStartEvent">
      <bpmn:outgoing>SequenceFlow_to_receive_task</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:receiveTask id="SystemReceiveTask" name="Wait here">
      <bpmn:incoming>SequenceFlow_to_receive_task</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_to_end</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sequenceFlow id="SequenceFlow_to_receive_task" sourceRef="SystemStartEvent" targetRef="SystemReceiveTask" />
    <bpmn:endEvent id="SystemEndEvent">
      <bpmn:incoming>SequenceFlow_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_to_end" sourceRef="SystemReceiveTask" targetRef="SystemEndEvent" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="system-receive-task-process">
      <bpmndi:BPMNShape id="SystemStartEvent_di" bpmnElement="SystemStartEvent">
        <dc:Bounds x="173" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SystemReceiveTask_di" bpmnElement="SystemReceiveTask">
        <dc:Bounds x="300" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow_to_receive_task_di" bpmnElement="SequenceFlow_to_receive_task">
        <di:waypoint x="209" y="120" />
        <di:waypoint x="300" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="SystemEndEvent_di" bpmnElement="SystemEndEvent">
        <dc:Bounds x="491" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow_to_end_di" bpmnElement="SequenceFlow_to_end">
        <di:waypoint x="400" y="120" />
        <di:waypoint x="491" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
