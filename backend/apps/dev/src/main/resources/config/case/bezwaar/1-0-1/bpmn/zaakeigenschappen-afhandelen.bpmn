    <bpmn:serviceTask id="zaakeigenschap-zoeken-st" name="Zoek op zaak eigenschappen">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">function toJs(value) {   if (value === null || value === undefined) {     return null;   }   if (typeof value !== 'object') {     return value;   }   if (typeof value.entrySet === 'function') {     var result = {};     var iterator = value.entrySet().iterator();     while (iterator.hasNext()) {       var entry = iterator.next();       result[String(entry.getKey())] = toJs(entry.getValue());     }     return result;   }   if (typeof value.size === 'function' &amp;&amp; typeof value.get === 'function') {     var list = [];     for (var i = 0; i &lt; value.size(); i++) {       list.push(toJs(value.get(i)));     }     return list;   }   return String(value); } execution.setVariable('eigenschappenResultJson', JSON.stringify(toJs(execution.getVariable(execution.getVariable('eigenschappenResultPV')), null, 2)));</camunda:script>
        </camunda:executionListener>
        <camunda:executionListener expression="${execution.setVariable(&#39;eigenschappenResultPV&#39;, execution.getVariable(&#39;resultProcessVariable&#39;))}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0njrlgn</bpmn:incoming>
      <bpmn:outgoing>Flow_14vrqzb</bpmn:outgoing>
    </bpmn:serviceTask>
