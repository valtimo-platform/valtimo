  <bpmn:process id="case-messaging" name="Case messaging" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="start-event" name="Case started">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
