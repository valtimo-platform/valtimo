<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_verhuizing_cascade" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="verhuizing" name="Verhuizing" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="StartEvent_1" name="Aanvraag ontvangen">
      <bpmn:outgoing>Flow_start_registreer</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="registreer_ontvangst" name="Registreer ontvangst" camunda:expression="${valueResolverDelegateService.handleValue(execution, 'doc:/status', 'in_behandeling')}">
      <bpmn:incoming>Flow_start_registreer</bpmn:incoming>
      <bpmn:outgoing>Flow_registreer_inspectie</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="CallInspectieActivity" name="Inspectie uitvoeren (bouwsteen)" camunda:asyncAfter="true" calledElement="verhuizing-inspectie-process" camunda:calledElementBinding="versionTag" camunda:calledElementVersionTag="BB:verhuizing-inspectie:1.0.2">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{buildingBlockDocumentId}" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_registreer_inspectie</bpmn:incoming>
      <bpmn:outgoing>Flow_inspectie_beoordelen</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="beoordelen_verhuizing" name="Beoordelen verhuizing">
      <bpmn:incoming>Flow_inspectie_beoordelen</bpmn:incoming>
      <bpmn:outgoing>Flow_beoordelen_afronden</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="afronden" name="Verhuizing afronden" camunda:expression="${valueResolverDelegateService.handleValue(execution, 'doc:/status', 'afgehandeld')}">
      <bpmn:incoming>Flow_beoordelen_afronden</bpmn:incoming>
      <bpmn:outgoing>Flow_afronden_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_end" name="Verhuizing afgehandeld">
      <bpmn:incoming>Flow_afronden_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_registreer" sourceRef="StartEvent_1" targetRef="registreer_ontvangst"/>
    <bpmn:sequenceFlow id="Flow_registreer_inspectie" sourceRef="registreer_ontvangst" targetRef="CallInspectieActivity"/>
    <bpmn:sequenceFlow id="Flow_inspectie_beoordelen" sourceRef="CallInspectieActivity" targetRef="beoordelen_verhuizing"/>
    <bpmn:sequenceFlow id="Flow_beoordelen_afronden" sourceRef="beoordelen_verhuizing" targetRef="afronden"/>
    <bpmn:sequenceFlow id="Flow_afronden_end" sourceRef="afronden" targetRef="Event_end"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="verhuizing">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="160" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="registreer_ontvangst_di" bpmnElement="registreer_ontvangst">
        <dc:Bounds x="250" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CallInspectieActivity_di" bpmnElement="CallInspectieActivity">
        <dc:Bounds x="410" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="beoordelen_verhuizing_di" bpmnElement="beoordelen_verhuizing">
        <dc:Bounds x="570" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="afronden_di" bpmnElement="afronden">
        <dc:Bounds x="730" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_end_di" bpmnElement="Event_end">
        <dc:Bounds x="892" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_registreer_di" bpmnElement="Flow_start_registreer">
        <di:waypoint x="196" y="120"/><di:waypoint x="250" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_registreer_inspectie_di" bpmnElement="Flow_registreer_inspectie">
        <di:waypoint x="350" y="120"/><di:waypoint x="410" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_inspectie_beoordelen_di" bpmnElement="Flow_inspectie_beoordelen">
        <di:waypoint x="510" y="120"/><di:waypoint x="570" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_beoordelen_afronden_di" bpmnElement="Flow_beoordelen_afronden">
        <di:waypoint x="670" y="120"/><di:waypoint x="730" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_afronden_end_di" bpmnElement="Flow_afronden_end">
        <di:waypoint x="830" y="120"/><di:waypoint x="892" y="120"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
