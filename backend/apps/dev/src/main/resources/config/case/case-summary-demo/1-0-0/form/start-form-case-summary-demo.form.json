{
    "display": "form",
    "components": [
        {
            "label": "HTML",
            "content": "Demo case for the <strong>case-summary</strong> external plugin. On start, a service task calls the plugin's <em>case-summary</em> action, which reads the fields below and writes a one-line summary to the <code>caseSummary</code> process variable. The <strong>Case summary (plugin)</strong> tab renders the plugin's own screen for this case.",
            "refreshOnChange": false,
            "key": "html",
            "type": "htmlelement",
            "input": false,
            "tableView": false
        },
        {
            "label": "Applicant name",
            "placeholder": "Jane Doe",
            "tableView": true,
            "validate": {
                "required": true
            },
            "key": "applicantName",
            "type": "textfield",
            "input": true
        },
        {
            "label": "Requested amount",
            "placeholder": "1250",
            "tableView": true,
            "key": "requestedAmount",
            "type": "number",
            "input": true
        },
        {
            "type": "button",
            "label": "Start",
            "key": "submit",
            "disableOnInvalid": true,
            "input": true,
            "tableView": false
        }
    ]
}
