<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Woningdossier" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.28.0">
  <bpmn:process id="woningdossier" name="Woningdossier" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="dossier_start" name="Dossier gestart">
      <bpmn:outgoing>Flow_dossier_start_vastleggen</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="dossier_vastleggen" name="Dossier vastleggen" camunda:expression="${valueResolverDelegateService.handleValue(execution, 'doc:/dossierStatus', 'vastgelegd')}">
      <bpmn:incoming>Flow_dossier_start_vastleggen</bpmn:incoming>
      <bpmn:outgoing>Flow_dossier_vastleggen_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="dossier_end" name="Dossier afgerond">
      <bpmn:incoming>Flow_dossier_vastleggen_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_dossier_start_vastleggen" sourceRef="dossier_start" targetRef="dossier_vastleggen" />
    <bpmn:sequenceFlow id="Flow_dossier_vastleggen_end" sourceRef="dossier_vastleggen" targetRef="dossier_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Woningdossier">
    <bpmndi:BPMNPlane id="BPMNPlane_Woningdossier" bpmnElement="woningdossier">
      <bpmndi:BPMNShape id="dossier_start_di" bpmnElement="dossier_start">
        <dc:Bounds x="172" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="152" y="175" width="78" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dossier_vastleggen_di" bpmnElement="dossier_vastleggen">
        <dc:Bounds x="260" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dossier_end_di" bpmnElement="dossier_end">
        <dc:Bounds x="412" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="392" y="175" width="78" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_dossier_start_vastleggen_di" bpmnElement="Flow_dossier_start_vastleggen">
        <di:waypoint x="208" y="150" />
        <di:waypoint x="260" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_dossier_vastleggen_end_di" bpmnElement="Flow_dossier_vastleggen_end">
        <di:waypoint x="360" y="150" />
        <di:waypoint x="412" y="150" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
