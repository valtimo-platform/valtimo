{
    "display": "form",
    "components": [
        {
            "key": "zaaktypeEigenschappenContainer",
            "type": "hidden",
            "input": true,
            "persistent": "client-only",
            "label": "Zaaktype eigenschappen container",
            "properties": {
                "sourceKey": "pv:zaaktypeEigenschappen"
            }
        },
        {
            "key": "pv:eigenschapUrl",
            "type": "select",
            "input": true,
            "label": "Eigenschap naam",
            "dataSrc": "custom",
            "data": {
                "custom": "values = data['zaaktypeEigenschappenContainer'];"
            },
            "widget": "choicesjs",
            "template": "<span>{{ item.definitie }}</span>",
            "valueProperty": "url",
            "idPath": "url",
            "validate": {
                "required": false
            }
        },
        {
            "key": "pv:resultProcessVariable",
            "type": "textfield",
            "input": true,
            "label": "result processvariable",
            "validate": {
                "required": false
            },
            "tableView": true,
            "attributes": {
                "data-testid": "zaakeigenschap-get-pv-resultProcessVariable"
            },
            "autoExpand": false,
            "applyMaskOn": "change",
            "defaultValue": "zaakeigenschap"
        },
        {
            "key": "submit",
            "type": "button",
            "input": true,
            "label": "Submit",
            "tableView": false,
            "disableOnInvalid": true
        }
    ]
}