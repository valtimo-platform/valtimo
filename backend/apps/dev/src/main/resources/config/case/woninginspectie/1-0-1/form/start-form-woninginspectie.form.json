{
    "display": "form",
    "components": [
        {
            "key": "html",
            "type": "htmlelement",
            "input": false,
            "label": "Woninginspectie aanvragen",
            "content": "Vul onderstaande gegevens in om een woninginspectie aan te vragen.",
            "tableView": false,
            "refreshOnChange": false
        },
        {
            "key": "aanvrager.naam",
            "type": "textfield",
            "input": true,
            "label": "Naam aanvrager",
            "tableView": true,
            "validate": {
                "required": true
            },
            "attributes": {
                "data-testid": "start-form-woninginspectie-naam"
            },
            "applyMaskOn": "change"
        },
        {
            "key": "adres",
            "type": "textfield",
            "input": true,
            "label": "Adres",
            "tableView": true,
            "attributes": {
                "data-testid": "start-form-woninginspectie-adres"
            },
            "applyMaskOn": "change"
        },
        {
            "key": "aantalKamers",
            "type": "number",
            "input": true,
            "label": "Aantal kamers",
            "tableView": true,
            "attributes": {
                "data-testid": "start-form-woninginspectie-aantal-kamers"
            }
        },
        {
            "key": "status",
            "type": "hidden",
            "input": true,
            "label": "Status",
            "tableView": false,
            "defaultValue": "ingediend"
        },
        {
            "key": "submit",
            "type": "button",
            "input": true,
            "label": "Woninginspectie aanvragen",
            "tableView": false,
            "disableOnInvalid": true
        }
    ]
}
