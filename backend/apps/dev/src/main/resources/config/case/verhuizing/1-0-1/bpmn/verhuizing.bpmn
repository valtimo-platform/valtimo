<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_verhuizing" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="verhuizing" name="Verhuizing" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_start_beoordelen</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="beoordelen_verhuizing" name="Beoordelen verhuizing">
      <bpmn:incoming>Flow_start_beoordelen</bpmn:incoming>
      <bpmn:outgoing>Flow_beoordelen_end</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_end">
      <bpmn:incoming>Flow_beoordelen_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_beoordelen" sourceRef="StartEvent_1" targetRef="beoordelen_verhuizing"/>
    <bpmn:sequenceFlow id="Flow_beoordelen_end" sourceRef="beoordelen_verhuizing" targetRef="Event_end"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="verhuizing">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="172" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="beoordelen_di" bpmnElement="beoordelen_verhuizing">
        <dc:Bounds x="260" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_end_di" bpmnElement="Event_end">
        <dc:Bounds x="412" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_beoordelen_di" bpmnElement="Flow_start_beoordelen">
        <di:waypoint x="208" y="120"/>
        <di:waypoint x="260" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_beoordelen_end_di" bpmnElement="Flow_beoordelen_end">
        <di:waypoint x="360" y="120"/>
        <di:waypoint x="412" y="120"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
