{
    "display": "form",
    "components": [
        {
            "key": "html",
            "type": "htmlelement",
            "input": false,
            "label": "Akkoord geven",
            "content": "Geef akkoord op de beoordeelde verhuizing.",
            "tableView": false,
            "refreshOnChange": false
        },
        {
            "key": "aanvrager.naam",
            "type": "textfield",
            "input": true,
            "label": "Naam aanvrager",
            "tableView": true,
            "disabled": true,
            "attributes": {
                "data-testid": "akkoord-geven-verhuizing-naam"
            },
            "applyMaskOn": "change"
        },
        {
            "key": "status",
            "type": "select",
            "input": true,
            "label": "Besluit",
            "tableView": true,
            "validate": {
                "required": true
            },
            "attributes": {
                "data-testid": "akkoord-geven-verhuizing-status"
            },
            "data": {
                "values": [
                    {
                        "label": "Akkoord",
                        "value": "akkoord"
                    },
                    {
                        "label": "Niet akkoord",
                        "value": "niet-akkoord"
                    }
                ]
            },
            "dataSrc": "values"
        },
        {
            "key": "submit",
            "type": "button",
            "input": true,
            "label": "Akkoord opslaan",
            "tableView": false,
            "disableOnInvalid": true
        }
    ]
}
