{
    "display": "form",
    "components": [
        {
            "key": "html",
            "type": "htmlelement",
            "input": false,
            "label": "HTML",
            "content": "Valideer de Status, Resultaat, Informatieobject en Rol typen die zijn opgehaald bij de Catalogi API.",
            "refreshOnChange": false
        },
        {
            "key": "statusType",
            "data": {
                "custom": "values = data['statusTypenContainer'];"
            },
            "type": "select",
            "input": true,
            "label": "Status type",
            "idPath": "url",
            "widget": "choicesjs",
            "dataSrc": "custom",
            "template": "<span>{{ item.name }}</span>",
            "valueProperty": "name",
            "validate": {
                "required": true
            },
            "attributes": {
                "data-testid": "user-task-validate-typen-statusType"
            },
            "properties": {
                "sourceKey": "pv:statusTypeName"
            }
        },
        {
            "label": "Status typen container",
            "persistent": "client-only",
            "key": "statusTypenContainer",
            "properties": {
                "sourceKey": "pv:statusTypen"
            },
            "attributes": {
                "data-testid": "user-task-validate-typen-statusTypenContainer"
            },
            "type": "hidden",
            "input": true
        },
        {
            "key": "resultaatType",
            "data": {
                "custom": "values = data['resultaatTypenContainer'];"
            },
            "type": "select",
            "input": true,
            "label": "Resultaat type",
            "idPath": "url",
            "widget": "choicesjs",
            "dataSrc": "custom",
            "template": "<span>{{ item.name }}</span>",
            "valueProperty": "name",
            "validate": {
                "required": true
            },
            "attributes": {
                "data-testid": "user-task-validate-typen-resultaatType"
            },
            "properties": {
                "sourceKey": "pv:resultaatTypeName"
            }
        },
        {
            "key": "resultaatTypenContainer",
            "type": "hidden",
            "input": true,
            "label": "Resultaat typen container",
            "attributes": {
                "data-testid": "user-task-validate-typen-resultaatTypenContainer"
            },
            "persistent": "client-only",
            "properties": {
                "sourceKey": "pv:resultaatTypen"
            }
        },
        {
            "key": "informatieObjectType",
            "data": {
                "custom": "values = data['informatieObjectTypenContainer'];"
            },
            "type": "select",
            "input": true,
            "label": "Informatieobject typen",
            "idPath": "url",
            "widget": "choicesjs",
            "dataSrc": "custom",
            "template": "<span>{{ item.name }}</span>",
            "valueProperty": "name",
            "validate": {
                "required": true
            },
            "attributes": {
                "data-testid": "user-task-validate-typen-informatieObjectType"
            },
            "properties": {
                "sourceKey": "pv:informatieObjectTypeName"
            }
        },
        {
            "key": "informatieObjectTypenContainer",
            "type": "hidden",
            "input": true,
            "label": "Informatieobject typen container",
            "attributes": {
                "data-testid": "user-task-validate-typen-informatieObjectTypenContainer"
            },
            "persistent": "client-only",
            "properties": {
                "sourceKey": "pv:informatieObjectTypen"
            }
        },
        {
            "key": "rolType",
            "data": {
                "custom": "values = data['rolTypenContainer'];"
            },
            "type": "select",
            "input": true,
            "label": "Rol typen",
            "idPath": "url",
            "widget": "choicesjs",
            "dataSrc": "custom",
            "template": "<span>{{ item.name }}</span>",
            "valueProperty": "name",
            "validate": {
                "required": true
            },
            "attributes": {
                "data-testid": "user-task-validate-typen-rolType"
            },
            "properties": {
                "sourceKey": "pv:rolTypeName"
            }
        },
        {
            "key": "rolTypenContainer",
            "type": "hidden",
            "input": true,
            "label": "Rol typen container",
            "attributes": {
                "data-testid": "user-task-validate-typen-rolTypenContainer"
            },
            "persistent": "client-only",
            "properties": {
                "sourceKey": "pv:rolTypen"
            }
        },
        {
            "key": "submit",
            "type": "button",
            "input": true,
            "label": "Submit",
            "disableOnInvalid": true
        }
    ]
}