{
    "$id": "verhuizing.schema",
    "type": "object",
    "title": "Verhuizing",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "required": [
        "aanvrager",
        "status",
        "scenario"
    ],
    "properties": {
        "scenario": {
            "type": "string"
        },
        "aanvrager": {
            "type": "object",
            "required": [
                "naam"
            ],
            "properties": {
                "naam": {
                    "type": "string"
                },
                "emailadres": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "nieuwAdres": {
            "type": [
                "string",
                "null"
            ]
        },
        "status": {
            "type": "string"
        },
        "spoed": {
            "type": [
                "boolean",
                "null"
            ]
        },
        "aantalPersonen": {
            "type": [
                "integer",
                "null"
            ]
        },
        "oppervlakte": {
            "type": "number"
        },
        "verhuisdatum": {
            "type": "string",
            "format": "date"
        },
        "documenten": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    }
}
