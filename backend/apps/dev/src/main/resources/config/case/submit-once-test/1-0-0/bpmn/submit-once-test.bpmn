<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_submit_once_test"
                  targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.26.0">
    <bpmn:process id="submit-once-test" name="Submit once test" isExecutable="true">
        <bpmn:startEvent id="start-event" name="Start">
            <bpmn:outgoing>Flow_start_to_task</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="Flow_start_to_task" sourceRef="start-event" targetRef="submit-once-task"/>
        <bpmn:userTask id="submit-once-task" name="Submit once task" camunda:candidateGroups="ROLE_USER">
            <bpmn:incoming>Flow_start_to_task</bpmn:incoming>
            <bpmn:outgoing>Flow_task_to_end</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:sequenceFlow id="Flow_task_to_end" sourceRef="submit-once-task" targetRef="end-event"/>
        <bpmn:endEvent id="end-event" name="End">
            <bpmn:incoming>Flow_task_to_end</bpmn:incoming>
        </bpmn:endEvent>
    </bpmn:process>
    <bpmndi:BPMNDiagram id="BPMNDiagram_submit_once_test">
        <bpmndi:BPMNPlane id="BPMNPlane_submit_once_test" bpmnElement="submit-once-test">
            <bpmndi:BPMNShape id="start-event_di" bpmnElement="start-event">
                <dc:Bounds x="152" y="102" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="submit-once-task_di" bpmnElement="submit-once-task">
                <dc:Bounds x="240" y="80" width="100" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="end-event_di" bpmnElement="end-event">
                <dc:Bounds x="392" y="102" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNEdge id="Flow_start_to_task_di" bpmnElement="Flow_start_to_task">
                <di:waypoint x="188" y="120"/>
                <di:waypoint x="240" y="120"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Flow_task_to_end_di" bpmnElement="Flow_task_to_end">
                <di:waypoint x="340" y="120"/>
                <di:waypoint x="392" y="120"/>
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
</bpmn:definitions>
