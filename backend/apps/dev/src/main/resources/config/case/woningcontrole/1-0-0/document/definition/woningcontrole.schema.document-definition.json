{
    "$id": "woningcontrole.schema",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Woningcontrole",
    "type": "object",
    "properties": {
        "adres": {
            "type": "string",
            "description": "Adres van de gecontroleerde woning"
        },
        "controleur": {
            "type": "string",
            "description": "Naam van de controleur"
        },
        "status": {
            "type": "string",
            "description": "Status van de controle"
        },
        "aantalGebreken": {
            "type": ["integer", "null"],
            "description": "Aantal geconstateerde gebreken"
        },
        "risicoscore": {
            "type": ["number", "null"],
            "description": "Berekende risicoscore"
        },
        "spoed": {
            "type": ["boolean", "null"],
            "description": "Of de controle met spoed moet worden opgevolgd"
        },
        "migratedFrom": {
            "type": "string",
            "description": "Versie waarvandaan deze zaak is gemigreerd"
        },
        "gemigreerdDoor": {
            "type": "string",
            "description": "Migratieplan dat deze zaak heeft gemigreerd"
        }
    }
}
