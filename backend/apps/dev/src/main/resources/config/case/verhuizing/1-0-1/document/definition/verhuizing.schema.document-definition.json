{
    "$id": "verhuizing.schema",
    "type": "object",
    "title": "Verhuizing",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "required": [
        "aanvrager",
        "status"
    ],
    "properties": {
        "aanvrager": {
            "type": "object",
            "required": [
                "naam"
            ],
            "properties": {
                "naam": {
                    "type": "string"
                },
                "emailadres": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                }
            }
        },
        "nieuwAdres": {
            "type": "string"
        },
        "status": {
            "type": "string"
        },
        "spoed": {
            "type": "boolean"
        },
        "aantalPersonen": {
            "type": "integer"
        },
        "oppervlakte": {
            "type": "number"
        },
        "verhuisdatum": {
            "type": "string",
            "format": "date"
        },
        "documenten": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "migratedFrom": {
            "type": "string"
        },
        "inspectieStatus": {
            "type": "string"
        }
    }
}
