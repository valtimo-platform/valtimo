{
    "display": "form",
    "components": [
        {
            "label": "HTML",
            "content": "This building block was started by a message. The subject below came from the case through the input mapping of the case definition link.",
            "refreshOnChange": false,
            "key": "html",
            "type": "htmlelement",
            "input": false,
            "tableView": false
        },
        {
            "label": "Subject",
            "disabled": true,
            "tableView": true,
            "key": "subject",
            "type": "textfield",
            "input": true
        },
        {
            "label": "Handled by",
            "placeholder": "Who picked this up?",
            "tableView": true,
            "validate": {
                "required": true
            },
            "key": "handledBy",
            "type": "textfield",
            "input": true
        },
        {
            "type": "button",
            "label": "Acknowledge",
            "key": "submit",
            "disableOnInvalid": true,
            "input": true,
            "tableView": false
        }
    ]
}
